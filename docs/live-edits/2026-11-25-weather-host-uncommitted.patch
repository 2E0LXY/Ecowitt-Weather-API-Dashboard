+async def satellite_image_exists(client, image):
+    """True if the source server really serves this image (HEAD, then a 1-byte ranged GET if HEAD is refused)."""
+    try:
+        resp = await client.head(image["url"], timeout=6.0)
+        if resp.status_code in (405, 501):
+            resp = await client.get(image["url"], headers={"Range": "bytes=0-0"}, timeout=6.0)
+        return resp.status_code in (200, 206)
+    except httpx.HTTPError:
+        return False
+
+
+async def satellite_images_with_verified_derived(client, parsed, capture):
+    """Parsed images plus the derived SatDump ones that actually exist on the source server."""
+    known = {img.get("filename") for img in parsed}
+    extra = [img for img in derived_satdump_weather_images(capture) if img.get("filename") not in known]
+    verified = [img for img in extra if await satellite_image_exists(client, img)]
+    return unique_satellite_images(list(parsed) + verified)
+
